{
  "name": "stribog",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, honest control room for MikroTik home networks: topology, Wi-Fi and a setup audit.",
  "type": "module",
  "bin": {
    "stribog": "./src/cli/stribog.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx src/server/server.ts",
    "review": "tsx src/cli/stribog.ts audit",
    "collect": "tsx src/cli/stribog.ts collect",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
